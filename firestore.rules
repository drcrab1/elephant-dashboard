rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 's01025144826@gmail.com';
    }
    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // 업무내역(배송건수) — 기사님은 본인 기록만 읽고 쓸 수 있고, 관리자는 전체를 볼 수 있습니다.
    match /workRecords/{recordId} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin() || isOwner(resource.data.email);
    }

    // 계약서·동의서: 서명 이미지와 개인정보가 들어 있어 대표자 + 해당 기사님(서명 대상자/작성자)만 읽을 수 있습니다.
    // 기사님은 본인에게 온 "서명대기" 문서에 서명 관련 항목만 바꿀 수 있고(서명완료로만 변경), 삭제·신규 발송은 대표자만 가능합니다.
    match /contracts/{contractId} {
      allow read: if isAdmin() || isOwner(resource.data.targetEmail) || isOwner(resource.data.ownerEmail);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('ownerEmail', '') == request.auth.token.email);
      allow update: if isAdmin() || (
        isOwner(resource.data.get('targetEmail', ''))
        && resource.data.get('status', '') == '서명대기'
        && request.resource.data.status == '서명완료'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureField', 'consents', 'signedAt', 'status', 'templateVersion', 'signedDate'])
      );
      allow delete: if isAdmin();
    }

    // 차량·자격 서류(자격증/등록증 사진): 본인이 올린 것만 읽고 관리할 수 있고, 대표자는 전체를 볼 수 있습니다.
    match /vehicleDocs/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('email', '') == request.auth.token.email);
      allow update: if isAdmin() || (isOwner(resource.data.get('email', '')) && request.resource.data.get('email', '') == resource.data.get('email', ''));
      allow delete: if isAdmin() || isOwner(resource.data.get('email', ''));
    }

    // ── 개인정보 보호 대응(개인정보 관리) ──
    // 문서 보관함: 대표자 전용. 버전 문서는 "저장 시각 = 서버 시각"일 때만 생성되고, 이후 수정·삭제할 수 없습니다(날짜 소급 불가).
    match /privacyDocs/{type} {
      allow read, write: if isAdmin();
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    // 연간 점검 이력: 대표자 전용, 생성 후 수정·삭제 불가
    match /privacyChecks/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // 교육자료: 로그인한 사용자는 열람, 등록/종료는 대표자만
    match /privacyTrainings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // 교육 이수 기록: 본인 이수만 기록 가능(서버 시각 고정), 수정·삭제 불가. 대표자는 전체 조회.
    match /privacyTrainingLogs/{id} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email && request.resource.data.completedAt == request.time;
      allow update, delete: if false;
    }
    // 전자 서약서: 본인 서명만 생성(서버 시각 고정), 수정·삭제 불가. 대표자는 전체 조회.
    match /pledges/{id} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email && request.resource.data.signedAt == request.time;
      allow update, delete: if false;
    }

    // ── 접근권한 최소화(쿠팡 수탁사 개인정보 처리 실태 점검 대응) ──

    // 접속기록: 서버 함수(관리자 권한)만 기록하고 대표자만 조회합니다. 클라이언트의 수정·삭제는 불가(위·변조 방지).
    match /accessLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 회원 정보(이름·연락처·알림 토큰·권한 플래그): 본인 문서만 읽을 수 있고, 대표자는 전체를 관리합니다.
    // 기사 본인은 알림 토큰과 본인 서약서 서명 표시(서버 시각)만 바꿀 수 있어 스스로 권한·계정 상태를 바꿀 수 없습니다.
    match /users/{userEmail} {
      allow read: if isAdmin() || isOwner(userEmail);
      allow create: if isAdmin() || (
        isOwner(userEmail)
        && request.resource.data.role == 'driver'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'role', 'createdAt', 'pledgeRequired', 'isActive'])
      );
      allow update: if isAdmin() || (
        isOwner(userEmail)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'joinPledgeSignedAt', 'leavePledgeSignedAt'])
        && (request.resource.data.get('joinPledgeSignedAt', null) == resource.data.get('joinPledgeSignedAt', null) || request.resource.data.joinPledgeSignedAt == request.time)
        && (request.resource.data.get('leavePledgeSignedAt', null) == resource.data.get('leavePledgeSignedAt', null) || request.resource.data.leavePledgeSignedAt == request.time)
      );
      allow delete: if isAdmin() || isOwner(userEmail);
    }

    // 비상연락망: 비상시 연락을 위해 로그인한 사용자는 열람 가능. 등록·수정은 대표자, 기사 본인은 본인 항목의 연락처/차량·자격 번호만 수정.
    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.email == request.auth.token.email && request.resource.data.role == '배송기사');
      allow update: if isAdmin() || (isOwner(resource.data.email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'carNumber', 'licenseNumber']));
      allow delete: if isAdmin() || isOwner(resource.data.email);
    }

    // 설정: 로그인한 사용자는 열람(스케줄 주소 등), 수정은 대표자만. (안전점검 완료 표시는 현재 화면 구조상 예외)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || settingId == 'safetyRecurringChecklist';
    }

    // 안전보건 기록(사고 보고 등): 본인이 작성한 것만 열람·관리, 대표자는 전체.
    match /safetyRecords/{recordId} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin() || isOwner(resource.data.email);
    }

    // 차량 유지비 기록: 본인 것만.
    match /vehicleCosts/{costId} {
      allow read: if isAdmin() || isOwner(resource.data.email);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin() || isOwner(resource.data.email);
    }

    // 공지 기록·공지 템플릿: 공지 열람은 로그인 사용자, 발송·관리는 대표자.
    match /noticeBoard/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notificationTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // 개인정보 사고 대장 / 파기 대장: 대표자 전용, 생성 후 수정·삭제 불가(서버 시각 고정). 사고 처리 경과는 events에 계속 추가합니다.
    match /privacyIncidents/{incidentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /destructionLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 노선(라우트) 정보·안전점검 체크 기록: 로그인한 사용자 공용 (이름·체크 여부 수준의 정보)
    match /routes/{routeId} {
      allow read, write: if isSignedIn();
    }
    match /safetyChecklistLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // ⚠ 주의: Firestore 규칙은 한 문서에 여러 match가 겹치면 "하나라도 허용하면 허용"입니다.
    // 그래서 모든 컬렉션을 허용하는 포괄 규칙(match /{collection}/{docId})은 두지 않습니다.
    // 새 컬렉션을 만들면 반드시 위처럼 명시적으로 규칙을 추가하세요. (명시되지 않은 컬렉션은 기본적으로 모두 거부)
  }
}
